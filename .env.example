# ==============================================================================
# FEASTHUB PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string used by Prisma Client & Migrations
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_delivery_db?schema=public"

# If using Supabase / Neon / AWS RDS connection pooling (PgBouncer), supply the direct connection URL:
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/food_delivery_db?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# A cryptographically secure random string (minimum 32 characters)
# Generate via terminal: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"

# The canonical base URL of your deployed application
# Local development: http://localhost:3000
# Production: https://your-domain.com or https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. APPLICATION & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 4. OPTIONAL INTEGRATIONS (For future payment gateway & image storage)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# UPLOADTHING_SECRET="sk_live_..."
# UPLOADTHING_APP_ID="..."
